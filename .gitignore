# Project specific
/tools/mkptypes/mkptypes
/build/
/build_wasm/
src/build/
FLOPPY.IMG
SMD0.IMG
/asm/
/glass-backup/

# Auto-generated function prototype headers (produced by mkptypes at build time).
# Tracking these in git causes false-positive freshness checks: git checkout sets
# all files to the same mtime, so CMake skips regeneration even when the header
# is stale relative to its source — leading to "conflicting types" build errors.
*_protos.h

# RetroTermWeb build output (rebuilt from submodule)
template-glass/lib/retroterm/
template-glass/lib/ndfs/

# TypeScript compiled output (rebuilt by ts-compile target)
template-glass/js/terminal-core.js
template-glass/js/terminal-manager.js
template-glass/js/terminal-bridge.js
template-glass/js/terminal-popout-app.js

# Uploaded/vendored PDF manuals (large; kept out of git, served by build)
template-glass/PDF/*.pdf

# Python bytecode from tools/ automation
tools/__pycache__/
**/__pycache__/

# Vendored prebuilt MinGW libcurl (fetched by scripts/fetch-curl.sh, not committed)
external/curl/
external/curl-*-win64-mingw.zip

# Disk/tape images at the repo root (scratch packs, test images, Windows ADS
# metadata). Sanctioned image location is images/ - root-level images are
# working copies and must never end up in a commit.
/*.IMG
/*.img
/*.image
*:Zone.Identifier
.gate.lock/
